---
import Base from '../../layouts/Base.astro';
import { history, eras } from '../../data/history';
---

<Base title="History" page="History" description="A walking timeline of left-wing history.">
  <section class="hero" style="padding:64px 0;">
    <div class="container">
      <div class="eyebrow">Timeline</div>
      <h1 style="font-size:clamp(2.2rem,5vw,3.4rem);">The History of the Left</h1>
      <p class="lede" style="font-size:1.05rem;">
        {history.length} moments from the first utopias to the crises of today — a walking
        tour through five centuries of struggle.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:40px;">
    <div class="container">
      <div class="eras">
        {
          eras.map((e) => (
            <div class="era-card">
              <div class="e-label">{e.key}</div>
              <div class="e-name">{e.label}</div>
              <div class="e-range">{e.from} – {e.to}</div>
            </div>
          ))
        }
      </div>

      <div class="timeline" id="timeline">
        {
          history.map((h, i) => (
            <article
              class="event reveal"
              data-era={h.era}
              style={`--i:${i}`}
            >
              {
                h.image && (
                  <div class="event-media">
                    <img src={h.image} alt={`${h.title} (${h.year})`} loading="lazy" />
                  </div>
                )
              }
              <div class="event-body">
                <div class="year">{h.year}</div>
                <h3>{h.title}</h3>
                <div class="loc">{h.location}</div>
                <p>{h.body}</p>
                {
                  h.learnMore && (
                    <a
                      class="learn-more"
                      href={h.learnMore.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Learn more about {h.learnMore.label} <span class="arrow">→</span>
                    </a>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // Scroll-reveal: fade/slide events in as they enter the viewport.
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }
</script>
